PORT=3001
CORS_ORIGIN=http://localhost:3002,http://127.0.0.1:3002
NODE_ENV=development
PORT=3001

DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# Supabase Auth is still required for login/register flows.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Cognito (validacion del JWT) ---
# El front manda el ID token de Cognito. El guard valida firma contra el JWKS del
# pool, `iss` contra el issuer y `aud` contra el client id.
# El rol sale de `cognito:groups` por lista blanca (Cognito agrega un grupo
# autogenerado `<poolId>_Google` por el IdP federado que NO es un rol).
# El tenant sale del atributo custom `custom:colegioId`.
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_h1uG5pYAS
COGNITO_CLIENT_ID=76b244eh09k8tto893sqeron6m
